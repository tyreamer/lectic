# Local review (development identity, loopback only). Never enable on a public host.
LECTIC_DEV=1
LECTIC_ORIGIN=http://127.0.0.1:8780
LECTIC_CLOUD_DATA=/absolute/path/outside/your/project
LECTIC_AI_BUDGET_MICRODOLLARS=1000000
# Set OPENAI_API_KEY in your process environment or secret manager.
# Production requires LECTIC_DEV unset, HTTPS origin, and dedicated credentials:
# LECTIC_DATABASE_URL=postgresql+psycopg://...
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
