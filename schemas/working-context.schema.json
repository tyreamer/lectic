{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "working-context",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "pattern": "^context-[a-f0-9]{24}$"},
    "intent": {"type": "string", "minLength": 1},
    "using": {"type": "array", "items": {"type": "object"}},
    "task_context": {"type": "object"},
    "knowledge": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "string"},
    "portable_context": {"type": "string"}
  },
  "required": ["schema_version", "context_id", "intent", "using", "task_context", "knowledge", "gaps", "summary", "portable_context"],
  "additionalProperties": false
}
