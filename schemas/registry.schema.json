{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "updated_at": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bundled_path": {"type": "string"},
          "install_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "units": {
            "type": "integer"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "description",
          "publisher",
          "url",
          "install_name",
          "version",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "packs"
  ],
  "additionalProperties": false
}
